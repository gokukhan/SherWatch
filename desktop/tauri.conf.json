{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SherWatch",
  "version": "0.1.0",
  "identifier": "com.sherkhan.sherwatch",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Sher Khan",
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "Per-process network monitoring and threat analysis",
    "longDescription": "SherWatch Command Center watches every program that sends data out of this PC, matches it against threat-intelligence feeds and known-exploited-vulnerability catalogues, and explains what it sees.",
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": ["English"]
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
